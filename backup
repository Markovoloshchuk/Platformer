local Dialogue = require("dialogue")

function love.load()
    love.window.setTitle("Platformer with Camera")
    love.window.setMode(800, 600)

    -- Ініціалізація діалогів
    Dialogue.load()

    -- Текст для діалогу
    my_lyrics = {
        "Hello!",
        "Look at this camera movement.",
        "Try to climb up the platforms!",
        "The world is huge now."
    }

    -- ============================
    -- НАЛАШТУВАННЯ СВІТУ І КАМЕРИ
    -- ============================
    
    -- Межі світу (тепер він високий і широкий)
    world_boundaries = {
        width = 2000,       -- Ширина рівня
        top_limit = -400,  -- Верхня межа (небо, від'ємні координати)
        bottom_limit = 600  -- Нижня межа (земля)
    }

    camera_x = 0
    camera_y = 0

    gravity = 1500
    ground_y = 500

    colors = {
        cyan = {0, 1, 1},
        red = {1, 0, 0},
        yellow = {1, 1, 0},
        ground = {0, 0.8, 0}
    }

    -- Гравець
    player = {
        x = 100,
        y = 100,
        width = 50,
        height = 50,
        speed = 400,
        y_velocity = 0,
        jump_force = -700,
        is_on_ground = false,

        coyote_duration = 0.10,
        coyote_timer = 0
    }

    -- Масиви об'єктів
    spikes = {}
    platforms = {}

    -- Функції створення об'єктів
    function spawnSpike(x, y)
        table.insert(spikes, {x = x, y = y, width = 50, height = 50})
    end
    
    function spawnPlatform(x, y, width)
        table.insert(platforms, {x = x, y = y, width = width, height = 25})
    end

    -- ============================
    -- СТВОРЕННЯ РІВНЯ
    -- ============================
    
    -- Шипи
    spawnSpike(400, 450)
    spawnSpike(600, 450)
    
    -- Платформи (Драбинка вгору)
    spawnPlatform(150, 350, 150)
    spawnPlatform(400, 250, 350)
    spawnPlatform(650, 100, 350)
    spawnPlatform(400, -50, 150)  -- Вже вище екрану
    spawnPlatform(150, -200, 150) -- Ще вище (негативні Y)
    spawnPlatform(400, -350, 150)
end

function love.update(dt)
    -- 1. ДІАЛОГ
    -- Якщо діалог активний, оновлюємо ТІЛЬКИ його і зупиняємо гру
    if Dialogue.isActive then
        Dialogue.update(dt)
        return 
    end

    -- 2. КЕРУВАННЯ ГРАВЦЕМ
    local move_input = 0 -- Змінна напрямку: -1 (ліво), 1 (право), 0 (стоїмо)

    if love.keyboard.isDown("right") then move_input = 1 end
    if love.keyboard.isDown("left") then move_input = -1 end

    -- === КЕРУВАННЯ ГЕЙМПАДОМ ===
    local joysticks = love.joystick.getJoysticks()
    if #joysticks > 0 then
        local joystick = joysticks[1] -- Беремо перший геймпад
        
        -- Отримуємо значення лівого стіка по X (від -1 до 1)
        local axisX = joystick:getGamepadAxis("leftx") 

        -- "МЕРТВА ЗОНА" (Deadzone)
        -- Стіки старішають і можуть трохи "дрібіжжати", видаючи 0.001 або -0.05
        -- Ігноруємо слабкі натискання менше 0.2
        if math.abs(axisX) > 0.2 then
            if axisX > 0 then move_input = 1 else move_input = -1 end
        end
        
        -- Також підтримка хрестовини (D-Pad)
        if joystick:isGamepadDown("dpright") then move_input = 1 end
        if joystick:isGamepadDown("dpleft") then move_input = -1 end
    end

    -- === ЗАСТОСУВАННЯ РУХУ ===
    if move_input == 1 and (player.x + player.width) < world_boundaries.width then
        player.x = player.x + (player.speed * dt)
    elseif move_input == -1 and player.x > 0 then
        player.x = player.x - (player.speed * dt)
    end

    -- 3. ФІЗИКА
    player.y_velocity = player.y_velocity + (gravity * dt)
    player.y = player.y + (player.y_velocity * dt)
    player.is_on_ground = false

    -- Колізія з землею
    if player.y > (ground_y - player.height) then
        player.y = ground_y - player.height
        player.y_velocity = 0
        player.is_on_ground = true
    end

    -- Колізія з платформами
    for _, p in ipairs(platforms) do
        local player_bottom = player.y + player.height
        
        -- Застрибуємо тільки зверху вниз
        if player.y_velocity > 0 and 
           player_bottom > p.y and 
           player_bottom < p.y + p.height and
           player.x + player.width > p.x and 
           player.x < p.x + p.width then
            
            player.y = p.y - player.height
            player.y_velocity = 0
            player.is_on_ground = true
        end
    end

    -- Колізія з шипами
    for _, s in ipairs(spikes) do
        -- Зменшений хітбокс для шипа (для чесності)
        if checkCollision(player.x, player.y, player.width, player.height, 
                          s.x + 10, s.y + 20, s.width - 20, s.height - 20) then
            -- Респаун на початку
            player.x = 100
            player.y = 100
            player.y_velocity = 0
        end
    end

    -- === ЛОГІКА COYOTE TIME ===
    
    if player.is_on_ground then
        -- Поки ми на землі, таймер завжди "заряджений"
        player.coyote_timer = player.coyote_duration
    else
        -- Якщо ми в повітрі (впали або зійшли з краю), час спливає
        player.coyote_timer = player.coyote_timer - dt
    end

    -- 4. КАМЕРА (Magic happens here)
    local screen_w = love.graphics.getWidth()
    local screen_h = love.graphics.getHeight()

    -- Рахуємо центр: (Гравець - Пів екрана)
    camera_x = player.x - (screen_w / 2) + (player.width / 2)
    camera_y = player.y - (screen_h / 2) + (player.height / 2)

    -- Обмежуємо X (ширина)
    if camera_x < 0 then camera_x = 0 end
    if camera_x > world_boundaries.width - screen_w then
        camera_x = world_boundaries.width - screen_w
    end

    -- Обмежуємо Y (висота)
    -- Не даємо камері опуститися нижче землі (0)
    if camera_y > 0 then camera_y = 0 end 
    -- Не даємо камері піднятися вище верхньої межі
    if camera_y < world_boundaries.top_limit then
        camera_y = world_boundaries.top_limit
    end
end

function love.draw()
    -- Небо (фон)
    love.graphics.setBackgroundColor(0.4, 0.6, 1)

    -- [[ ПОЧАТОК ЗСУВУ КАМЕРИ ]]
    love.graphics.push()
    love.graphics.translate(-camera_x, -camera_y)

    -- 1. Земля (на всю ширину світу)
    love.graphics.setColor(colors.ground)
    love.graphics.rectangle("fill", 0, ground_y, world_boundaries.width, 200)

    -- 2. Гравець
    love.graphics.setColor(colors.red)
    love.graphics.rectangle("fill", player.x, player.y, player.width, player.height)

    -- 3. Платформи
    love.graphics.setColor(colors.cyan)
    for _, p in ipairs(platforms) do
        love.graphics.rectangle("fill", p.x, p.y, p.width, p.height)
    end

    -- 4. Шипи
    love.graphics.setColor(colors.yellow)
    for _, s in ipairs(spikes) do
        love.graphics.polygon("fill", 
            s.x, s.y + s.height,
            s.x + s.width, s.y + s.height,
            s.x + (s.width / 2), s.y
        )
    end

    -- [[ КІНЕЦЬ ЗСУВУ КАМЕРИ ]]
    love.graphics.pop()

    -- 5. ІНТЕРФЕЙС (Малюється поверх усього, не рухається)
    
    -- Відображення координат для тесту
    love.graphics.setColor(1, 1, 1)
    love.graphics.print("Player Y: " .. math.floor(player.y), 10, 10)
    love.graphics.print("Controls: Arrows to move, Space to Jump, Enter for Dialog", 10, 30)

    Dialogue.draw()
end

function love.keypressed(key)
    if key == "escape" then
        love.event.quit()
    end

    -- Логіка діалогу
    if Dialogue.isActive then
        Dialogue.keypressed(key)
        return -- Блокуємо решту кнопок під час діалогу
    end

    -- Логіка гри (тільки якщо діалог вимкнено)
    if key == "space" and player.coyote_timer > 0 then
        player.y_velocity = player.jump_force
        player.coyote_timer = 0
    end

    if key == "z" then
        Dialogue.start(my_lyrics)
    end
end

function love.gamepadpressed(joystick, button)
    -- button повертає рядок: "a", "b", "x", "y", "dpup", "start" тощо.
    
    -- 1. Діалог
    if Dialogue.isActive then
        -- Емулюємо натискання Space для діалогу кнопкою "A" (нижня кнопка)
        if button == "a" then
            Dialogue.keypressed("space") 
        end
        return
    end

    -- 2. Гра
    -- Кнопка "A" на Xbox або "X" на PlayStation
    if button == "a" and player.coyote_timer > 0 then
        player.y_velocity = player.jump_force
        player.coyote_timer = 0
    end

    -- Запуск діалогу на "Start" або "Y"
    if button == "start" or button == "y" then
         Dialogue.start(my_lyrics)
    end
    
    -- Вихід на "Back"
    if button == "back" then
        love.event.quit()
    end
end

-- Допоміжна функція перевірки колізій
function checkCollision(x1, y1, w1, h1, x2, y2, w2, h2)
    return x1 < x2 + w2 and
           x1 + w1 > x2 and
           y1 < y2 + h2 and
           y1 + h1 > y2
end